# TRUSETT - Environment Configuration Template
# Copy to .env and fill with your Hedera Testnet credentials from https://portal.hedera.com

# Hedera Operator Account
OPERATOR_ID=0.0.xxxxxxx
OPERATOR_KEY=your_private_key_here
HEDERA_NETWORK=testnet

# Hedera Portal PAT (Optional for portal management)
HEDERA_PORTAL_PAT=your_portal_pat_here

# Hedera Consensus Service (HCS)
# If left blank, the app will automatically create and save a new topic
HCS_TOPIC_ID=

# Hedera Token Service (HTS)
# Hedera Testnet USDC token ID (default is official testnet USDC)
USDC_TOKEN_ID=0.0.456858

# Hedera Smart Contract Service (HSCS)
# Escrow smart contract ID once deployed
ESCROW_CONTRACT_ID=

# Application Mode: 'true' enables local simulated workflow without testnet gas
# 'false' executes genuine Hedera transactions when operator keys are provided
DEMO_MODE=true

# AI Assistant: optional OpenAI or Gemini key for live LLM analysis
AI_API_KEY=
AI_MODEL=deterministic-demo
