# ==========================================
# TRUSETT - Git Ignore Rules
# ==========================================

# --- Secrets, Credentials & Local Accounts ---
.env
.env.local
.env.*.local
.envrc
!.env.example
*.key
*.pem
accounts.json

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/

# Type Checking & Linters
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# Databases & Runtime
*.sqlite3
*.sqlite3-journal
*.db
backend/data/*.db
*.log
celerybeat-schedule*
celerybeat.pid

# IDE & OS Specific
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
tempCodeRunnerFile.py
